rules_version = '2';

// Anything not matched below is denied - including /root_admin/{uid} (the root passcode's bcrypt hash
// and admin session), which only besa-api touches via the Admin SDK (which bypasses these rules).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() &&
        get(/databases/$(database)/documents/training_data/data_root/users/$(request.auth.uid)).data.admin == true;
    }

    // Fields only the backend may change: account tier/admin (root is hand-made and gates the
    // root admin login; admin is granted via /set-admin-status), roster identity, and kiosk clock/hours.
    function protectedUserFields() {
      return ['uid', 'accountType', 'admin', 'besaName', 'studentId',
              'biWeeklyHours', 'lastCheckedIn', 'lastCheckedInActivities'];
    }

    match /training_data/data_root/users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      // no client creates - besa-api's /create-account makes the doc, choosing tier/admin from the roster
      allow update: if signedIn() && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(protectedUserFields());
      // root deletes go through /root-admin/delete-account so its passcode is wiped along with it
      allow delete: if signedIn() && request.auth.uid == userId && resource.data.accountType != 'root';
    }

    // Admins manage the shared training content (scripts, fills, question sets, activity types on the
    // data_root doc itself) - but NOT other people's user docs, which are excluded here on purpose.
    match /training_data/data_root {
      allow read, write: if isAdmin();

      match /{collection}/{allPaths=**} {
        allow read, write: if collection != 'users' && isAdmin();
      }
    }

    match /training_data/data_root/scripts/{allPaths=**} {
      allow read: if true;
    }

    match /training_data/floors/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
